---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/newsreader/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../lib/types';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonical: string;
  alternate: string;
  documentTitle?: string;
  routeKey?: string;
  routeKind?: string;
  noindex?: boolean;
  installHint?: boolean;
}

const {
  locale, title, description, canonical, alternate,
  documentTitle, routeKey, routeKind, noindex = false, installHint = false,
} = Astro.props;
const preventIndexing = noindex || import.meta.env.PUBLIC_SITE_LIVE !== 'true';
const origin = 'https://www.gaestehaus-wild.com';
const canonicalUrl = new URL(canonical, origin);
const alternateUrl = new URL(alternate, origin);
const deUrl = locale === 'de' ? canonicalUrl : alternateUrl;
const enUrl = locale === 'en' ? canonicalUrl : alternateUrl;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: 'Gästehaus Wild',
  url: origin,
  telephone: '+49 911 996910',
  email: 'info@gaestehaus-wild.com',
  priceRange: '€65–€130',
  address: {
    '@type': 'PostalAddress', streetAddress: 'Jahnstraße 77', postalCode: '90522',
    addressLocality: 'Oberasbach', addressCountry: 'DE',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 49.4224662, longitude: 10.9807374 },
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#e8dfd0" />
    <meta name="description" content={description} />
    {preventIndexing && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={deUrl} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.png" />
    <title>{documentTitle ?? `${title} · Gästehaus Wild`}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#content">{locale === 'de' ? 'Zum Inhalt' : 'Skip to content'}</a>
    <Header locale={locale} alternateHref={alternate} routeKey={routeKey} routeKind={routeKind} />
    <main id="content"><slot /></main>
    <Footer locale={locale} />
    {installHint && (
      <aside class="install-hint" hidden aria-live="polite">
        <button type="button" aria-label={locale === 'de' ? 'Hinweis schließen' : 'Dismiss'}>×</button>
        <strong>{locale === 'de' ? 'Auch offline griffbereit' : 'Keep it handy offline'}</strong><br />
        <span>{locale === 'de' ? 'Über Teilen → „Zum Home-Bildschirm“ können Sie diese Gästemappe speichern.' : 'Use Share → “Add to Home Screen” to keep this guest guide handy.'}</span>
      </aside>
    )}
    <script>
      if ('serviceWorker' in navigator) window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
      const roomSelect = document.querySelector<HTMLSelectElement>('select[name="roomCategory"]');
      const requestedRoom = new URLSearchParams(window.location.search).get('room');
      if (roomSelect && requestedRoom && [...roomSelect.options].some((option) => option.value === requestedRoom)) roomSelect.value = requestedRoom;
    </script>
    {installHint && (
      <script is:inline>
        const hint = document.querySelector('.install-hint');
        const dismissed = localStorage.getItem('gaestehaus-wild.install-hint') === 'dismissed';
        const standalone = window.matchMedia('(display-mode: standalone)').matches;
        if (hint && !dismissed && !standalone) hint.hidden = false;
        hint?.querySelector('button')?.addEventListener('click', () => {
          hint.hidden = true;
          localStorage.setItem('gaestehaus-wild.install-hint', 'dismissed');
        });
      </script>
    )}
  </body>
</html>
