---
import PageRouter from '../../components/PageRouter.astro';
import { routes } from '../../lib/routes';

export function getStaticPaths() {
  return routes.filter((route) => route.en).map((route) => ({ params: { slug: route.en }, props: { route } }));
}
const { route } = Astro.props;
---
<PageRouter locale="en" route={route} />
