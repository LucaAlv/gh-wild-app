---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryLightbox from './islands/GalleryLightbox';
import GuideSearch from './islands/GuideSearch';
import NearbyExplorer from './islands/NearbyExplorer';
import StayPlanner from './islands/StayPlanner';
import WifiCard from './islands/WifiCard';
import { allRooms, legalById, pageById, roomById, settingById } from '../lib/content';
import { imageAsset } from '../lib/images';
import { hrefFor } from '../lib/routes';
import type { Locale, RouteDefinition } from '../lib/types';

interface Props { locale: Locale; route: RouteDefinition; }
const { locale, route } = Astro.props;
const de = locale === 'de';
const alternate = hrefFor(route.key, locale === 'de' ? 'en' : 'de');
const canonical = hrefFor(route.key, locale);

const titleByKind: Record<string, string> = {
  home: de ? 'Willkommen' : 'Welcome', rooms: de ? 'Zimmer' : 'Rooms', room: '',
  gallery: de ? 'Galerie' : 'Gallery', contact: de ? 'Kontakt' : 'Contact',
  nearby: de ? 'In der Nähe' : 'Nearby', arrival: de ? 'Anreise' : 'Getting here',
  guide: de ? 'Gästemappe A–Z' : 'House guide A–Z', guest: de ? 'Ich bin zu Gast' : "I'm staying here",
  stay: de ? 'Mein Aufenthalt' : 'My stay', inquiry: de ? 'Anfrage' : 'Inquiry',
  thanks: de ? 'Vielen Dank' : 'Thank you', legal: '', goodToKnow: '', breakfast: '', garden: '',
  about: '', services: '', vouchers: '',
};

let title = titleByKind[route.kind];
let description = de
  ? 'Familiengeführtes Gästehaus im historischen Fachwerkhaus in Oberasbach bei Nürnberg.'
  : 'A family-run guesthouse in a historic half-timbered house in Oberasbach near Nuremberg.';
let contentPage: Awaited<ReturnType<typeof pageById>> | undefined;
let legalPage: Awaited<ReturnType<typeof legalById>> | undefined;
let room: Awaited<ReturnType<typeof roomById>> | undefined;

if (route.contentId && ['home', 'breakfast', 'garden', 'about', 'services', 'vouchers', 'goodToKnow'].includes(route.kind)) {
  contentPage = await pageById(route.contentId);
  title = contentPage.data.title[locale];
  description = contentPage.data.intro[locale];
}
if (route.kind === 'legal' && route.contentId) {
  legalPage = await legalById(route.contentId);
  title = legalPage.data.title[locale];
}
if (route.kind === 'room' && route.roomId) {
  room = await roomById(route.roomId);
  title = room.data.name[locale];
  description = room.data.description[locale];
}

const rooms = ['home', 'rooms', 'room', 'stay', 'inquiry'].includes(route.kind) ? await allRooms() : [];
const noindex = route.noindex || Boolean(legalPage?.data.needsOwnerReview);
const pageImage = contentPage?.data.image ? imageAsset(contentPage.data.image) : undefined;
const amenities = de
  ? ['WC', 'Dusche oder Badewanne', 'Föhn', 'Duschgel, Shampoo & Seife', 'Ausreichend Handtücher', 'Kostenloses WLAN']
  : ['Toilet', 'Shower or bath', 'Hair dryer', 'Shower gel, shampoo & soap', 'Plenty of towels', 'Free Wi-Fi'];

let galleryImages: { thumbnail: string; full: string; alt: string }[] = [];
if (route.kind === 'gallery') {
  const gallery = await settingById<{ images: string[] }>('gallery');
  galleryImages = await Promise.all(gallery.images.map(async (name, index) => ({
    thumbnail: (await getImage({ src: imageAsset(name), width: 620, height: 465, fit: 'cover', format: 'webp', quality: 68 })).src,
    full: (await getImage({ src: imageAsset(name), width: 1500, format: 'avif', quality: 78 })).src,
    alt: de ? `Gästehaus Wild – Galerie Foto ${index + 1}` : `Gästehaus Wild gallery photo ${index + 1}`,
  })));
}

const guideEntries = route.kind === 'guide'
  ? (await getCollection('guide')).map((entry) => ({ id: entry.id, ...entry.data }))
  : [];

const nearbyPlaces = route.kind === 'nearby'
  ? await Promise.all((await getCollection('nearby')).map(async (entry) => ({
    id: entry.id,
    ...entry.data,
    imageUrl: entry.data.image
      ? (await getImage({ src: imageAsset(entry.data.image), width: 420, height: 560, fit: 'cover', format: 'webp' })).src
      : undefined,
  })))
  : [];

const arrivalEntries = route.kind === 'arrival' ? await getCollection('arrival') : [];
const wifi = route.kind === 'guest'
  ? await settingById<{ ssid: string; password: string | null }>('wifi')
  : undefined;
---

<BaseLayout locale={locale} title={title} description={description} canonical={canonical} alternate={alternate} noindex={noindex} installHint={route.kind === 'guest'}>
  {route.kind === 'home' && contentPage && (
    <>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">{contentPage.data.eyebrow?.[locale]}</p>
          <h1>{contentPage.data.intro[locale]}</h1>
          <p class="lead muted">{contentPage.data.body?.[locale]}</p>
          <div class="hero-actions">
            <a class="button" href={hrefFor('rooms', locale)}>{de ? 'Zimmer entdecken' : 'Explore rooms'}</a>
            <a class="button secondary" href={hrefFor('guest', locale)}>{de ? 'Ich bin zu Gast' : "I'm staying here"}</a>
          </div>
        </div>
        <div class="hero-image">
          <Image src={pageImage!} alt={de ? 'Historisches Fachwerkhaus des Gästehaus Wild' : 'The historic half-timbered Gästehaus Wild'} widths={[720, 1080, 1440]} sizes="(max-width: 1020px) 100vw, 55vw" format="avif" quality={72} loading="eager" />
          <div class="hero-note">{de ? 'Oberasbach · wenige Minuten von Nürnberg' : 'Oberasbach · minutes from Nuremberg'}</div>
        </div>
      </section>
      <section class="feature-strip">
        <div class="shell">
          <div class="feature"><strong>{de ? 'Seit 1990' : 'Since 1990'}</strong><span>{de ? 'familiengeführt' : 'family-run'}</span></div>
          <div class="feature"><strong>{de ? '16 Zimmer' : '16 rooms'}</strong><span>{de ? 'individuell eingerichtet' : 'individually furnished'}</span></div>
          <div class="feature"><strong>{de ? '300+ Jahre' : '300+ years'}</strong><span>{de ? 'Fachwerkgeschichte' : 'of half-timbered history'}</span></div>
        </div>
      </section>
      <section class="section shell">
        <div class="section-head"><div><p class="eyebrow">{de ? 'Bei uns übernachten' : 'Stay with us'}</p><h2>{de ? 'Ein Zimmer mit Charakter' : 'A room with character'}</h2></div><a class="text-link" href={hrefFor('rooms', locale)}>{de ? 'Alle Zimmer' : 'All rooms'} →</a></div>
        <div class="card-grid">
          {rooms.slice(0, 3).map((entry) => (
            <article class="room-card">
              <Image src={imageAsset(entry.data.images[0])} alt={entry.data.name[locale]} widths={[360, 620, 900]} sizes="(max-width: 700px) 100vw, 33vw" format="webp" />
              <div class="card-body"><h3>{entry.data.name[locale]}</h3><p class="muted">{entry.data.occupancy[locale]}</p><div class="card-meta"><span>{de ? `ab ${entry.data.price} €` : `from €${entry.data.price}`}</span><a class="text-link" href={hrefFor(entry.id, locale)} aria-label={`${entry.data.name[locale]} – ${de ? 'mehr erfahren' : 'learn more'}`}>→</a></div></div>
            </article>
          ))}
        </div>
      </section>
      {contentPage.data.testimonials?.[0] && (
        <section class="testimonial-section shell">
          <blockquote>
            <p>“{contentPage.data.testimonials[0][locale]}”</p>
            <footer>{de ? 'Ein Gast über seinen Aufenthalt' : 'A guest describing their stay'}</footer>
          </blockquote>
        </section>
      )}
      <section class="section shell split">
        <div class="page-image"><Image src={imageAsset('gallery-24'.replace('gallery', 'galerie'))} alt="" widths={[600, 1000]} sizes="(max-width: 700px) 100vw, 50vw" format="avif" /></div>
        <div><p class="eyebrow">{de ? 'Ihre Gastgeber' : 'Your hosts'}</p><h2>{de ? 'Persönlich. Echt. Wild.' : 'Personal. Genuine. Wild.'}</h2><p class="lead muted">{de ? 'Drei Generationen, ein historisches Haus und die Freude daran, Menschen willkommen zu heißen.' : 'Three generations, one historic house and the joy of welcoming people.'}</p><a class="button secondary" href={hrefFor('about', locale)}>{de ? 'Unsere Geschichte' : 'Our story'}</a></div>
      </section>
    </>
  )}

  {route.kind === 'rooms' && (
    <><section class="page-hero shell"><p class="eyebrow">{de ? 'Individuell eingerichtet' : 'Individually furnished'}</p><h1>{de ? 'Unsere Zimmer' : 'Our rooms'}</h1><p class="lead muted">{de ? 'Sieben Kategorien, 16 ganz unterschiedliche Zimmer – mit dem Charakter unseres alten Hauses und allem, was einen angenehmen Aufenthalt ausmacht.' : 'Seven categories, 16 individual rooms—with the character of our old house and everything needed for a comfortable stay.'}</p></section><section class="section tight shell"><div class="card-grid">{rooms.map((entry) => <article class="room-card"><Image src={imageAsset(entry.data.images[0])} alt={entry.data.name[locale]} widths={[360, 620, 900]} sizes="(max-width: 700px) 100vw, 33vw" format="webp" /><div class="card-body"><h3>{entry.data.name[locale]}</h3><p class="muted">{entry.data.occupancy[locale]}</p><p>{entry.data.description[locale]}</p><div class="card-meta"><span>{de ? `ab ${entry.data.price} €` : `from €${entry.data.price}`}</span><a class="text-link" href={hrefFor(entry.id, locale)}>{de ? 'Ansehen' : 'View'} →</a></div></div></article>)}</div></section></>
  )}

  {route.kind === 'room' && room && (
    <><section class="page-hero shell"><p class="eyebrow">{room.data.occupancy[locale]}</p><h1>{room.data.name[locale]}</h1><p class="lead muted">{room.data.description[locale]}</p></section><section class="section tight shell room-detail"><div class="room-detail-main"><Image src={imageAsset(room.data.images[0])} alt={room.data.name[locale]} widths={[720, 1100, 1500]} sizes="(max-width: 1020px) 100vw, 65vw" format="avif" /></div><aside class="paper-panel room-sidebar"><p class="eyebrow">{de ? 'Pro Nacht' : 'Per night'}</p><h2>{de ? `ab ${room.data.price} €` : `from €${room.data.price}`}</h2><p>{room.data.occupancy[locale]}</p><a class="button" href={`${hrefFor('inquiry', locale)}?room=${room.id}`}>{de ? 'Unverbindlich anfragen' : 'Send an inquiry'}</a><hr /><h3>{de ? 'Ausstattung' : 'Amenities'}</h3><ul class="amenities">{amenities.map((item) => <li>✓ {item}</li>)}</ul></aside></section></>
  )}

  {['breakfast', 'garden', 'about', 'services', 'vouchers', 'goodToKnow'].includes(route.kind) && contentPage && (
    <><section class="page-hero shell"><p class="eyebrow">{contentPage.data.eyebrow?.[locale]}</p><h1>{contentPage.data.title[locale]}</h1><p class="lead muted">{contentPage.data.intro[locale]}</p></section><section class="section tight shell split"><div class="prose"><p>{contentPage.data.body?.[locale]}</p>{contentPage.data.options && <ul>{contentPage.data.options.map((item) => <li>{item[locale]}</li>)}</ul>}<div class="hero-actions"><a class="button" href={hrefFor('inquiry', locale)}>{de ? 'Jetzt anfragen' : 'Enquire now'}</a>{route.kind === 'breakfast' && <a class="button secondary" href={hrefFor('guide', locale)}>{de ? 'Zur Gästemappe' : 'House guide'}</a>}</div></div>{pageImage ? <div class="page-image"><Image src={pageImage} alt={contentPage.data.title[locale]} widths={[600, 1000]} sizes="(max-width: 700px) 100vw, 50vw" format="avif" /></div> : <div class="paper-panel"><p class="eyebrow">{de ? 'Kontakt' : 'Contact'}</p><h3>{de ? 'Wir beraten Sie persönlich' : 'We are happy to advise you'}</h3><p>0911 996910<br />info@gaestehaus-wild.com</p></div>}</section></>
  )}

  {route.kind === 'gallery' && <><section class="page-hero shell"><p class="eyebrow">{de ? 'Einblicke' : 'A closer look'}</p><h1>{de ? 'Galerie' : 'Gallery'}</h1><p class="lead muted">{de ? 'Historisches Fachwerk, individuell eingerichtete Zimmer und Lieblingsplätze rund ums Haus.' : 'Historic half-timbering, individually furnished rooms and favourite corners around the house.'}</p></section><section class="section tight shell"><GalleryLightbox client:load images={galleryImages} closeLabel={de ? 'Galerie schließen' : 'Close gallery'} /></section></>}

  {route.kind === 'contact' && (
    <><section class="page-hero shell"><p class="eyebrow">{de ? 'Persönlich erreichbar' : 'Here in person'}</p><h1>{de ? 'Kontakt' : 'Contact'}</h1><p class="lead muted">{de ? 'Rufen Sie uns an, schreiben Sie uns oder kommen Sie vorbei. Wir freuen uns auf Sie.' : 'Call, write or come by. We look forward to hearing from you.'}</p></section><section class="section tight shell split"><div class="paper-panel"><h3>Gästehaus Wild</h3><p>Jahnstraße 77<br />90522 Oberasbach<br />{de ? 'Deutschland' : 'Germany'}</p><p><a href="tel:+49911996910">{de ? '0911 996910' : '+49 911 996910'}</a><br /><a href="mailto:info@gaestehaus-wild.com">info@gaestehaus-wild.com</a></p><div class="hero-actions"><a class="button" href={hrefFor('inquiry', locale)}>{de ? 'Anfrage senden' : 'Send inquiry'}</a><a class="button secondary" href="https://maps.apple.com/?daddr=49.4224662,10.9807374">{de ? 'Route öffnen' : 'Open directions'}</a></div></div><div><p class="eyebrow">{de ? 'Gut anzukommen' : 'Easy to reach'}</p><h2>{de ? 'Ruhig gelegen, nah an Nürnberg' : 'Peaceful, close to Nuremberg'}</h2><p class="lead muted">{de ? 'Kostenfreie Parkplätze finden Sie direkt vor dem Haus. Der Bahnhof Unterasbach ist etwa zwölf Gehminuten entfernt.' : 'Free parking is directly outside. Unterasbach station is about a twelve-minute walk away.'}</p><a class="text-link" href={hrefFor('arrival', locale)}>{de ? 'Anreise mit Bus & Bahn' : 'Getting here by public transport'} →</a></div></section></>
  )}

  {route.kind === 'guide' && <><section class="page-hero narrow"><p class="eyebrow">{de ? 'Schnell gefunden' : 'Find it quickly'}</p><h1>{de ? 'Gästemappe A–Z' : 'House guide A–Z'}</h1><p class="lead muted">{de ? 'Alles Wichtige für Ihren Aufenthalt – vom WLAN bis zum Check-out.' : 'Everything important for your stay—from Wi-Fi to check-out.'}</p></section><section class="section tight narrow"><GuideSearch client:load entries={guideEntries} locale={locale} /></section></>}

  {route.kind === 'nearby' && <><section class="page-hero shell"><p class="eyebrow">{de ? 'Lieblingsorte der Familie' : 'Family favourites'}</p><h1>{de ? 'In der Nähe' : 'Nearby'}</h1><p class="lead muted">{de ? 'Vom Hainberg vor der Tür bis zur Nürnberger Altstadt – nach Entfernung sortiert und mit unseren persönlichen Tipps.' : 'From the Hainberg outside to Nuremberg’s old town—sorted by distance with our personal tips.'}</p></section><section class="section tight shell"><NearbyExplorer client:load places={nearbyPlaces} locale={locale} /></section></>}

  {route.kind === 'arrival' && <><section class="page-hero narrow"><p class="eyebrow">{de ? 'Offline-Spickzettel' : 'Offline cheat sheets'}</p><h1>{de ? 'Anreise' : 'Getting here'}</h1><p class="lead muted">{de ? 'Die wichtigsten Wege vom Gästehaus – kurz, speicherbar und ohne Live-Routing.' : 'The most useful routes from the guesthouse—concise, savable and without live routing.'}</p></section><section class="section tight narrow route-list">{arrivalEntries.map((entry) => <article class="route-card"><p class="eyebrow">{entry.data.durationSummary[locale]}</p><h3>{entry.data.destination[locale]}</h3><ol>{entry.data.steps.map((step) => <li>{step[locale]}</li>)}</ol>{entry.data.tip && <p class="notice"><strong>{de ? 'Tipp:' : 'Tip:'}</strong> {entry.data.tip[locale]}</p>}</article>)}</section></>}

  {route.kind === 'stay' && (
    <><section class="page-hero shell"><p class="eyebrow">{de ? 'Privat auf Ihrem Gerät' : 'Private on your device'}</p><h1>{de ? 'Mein Aufenthalt' : 'My stay'}</h1><p class="lead muted">{de ? 'Speichern Sie Ihre Reisedaten lokal und nehmen Sie hilfreiche Erinnerungen direkt in Ihren Kalender mit.' : 'Save your travel dates locally and add helpful reminders straight to your calendar.'}</p></section><section class="section tight shell"><StayPlanner client:load locale={locale} rooms={rooms.map((entry) => ({ id: entry.id, name: entry.data.name }))} /></section></>
  )}

  {route.kind === 'guest' && wifi && <><section class="page-hero shell"><p class="eyebrow">{de ? 'Willkommen bei uns' : 'Welcome'}</p><h1>{de ? 'Ich bin zu Gast' : "I'm staying here"}</h1><p class="lead muted">{de ? 'WLAN, Frühstück und alles Wichtige für Ihren Aufenthalt – sofort zur Hand.' : 'Wi-Fi, breakfast and everything important for your stay—right at hand.'}</p></section><section class="section tight shell"><WifiCard client:load ssid={wifi.ssid} password={wifi.password} locale={locale} /><div class="guest-grid" style="margin-top: 18px"><a class="quick-card" href={hrefFor('stay', locale)}><span class="quick-icon">◫</span><h3>{de ? 'Mein Aufenthalt' : 'My stay'}</h3><span class="muted">{de ? 'Daten & Kalender' : 'Dates & calendar'}</span></a><a class="quick-card" href={hrefFor('guide', locale)}><span class="quick-icon">A–Z</span><h3>{de ? 'Gästemappe' : 'House guide'}</h3><span class="muted">{de ? 'Schnell durchsuchen' : 'Search quickly'}</span></a><a class="quick-card" href={hrefFor('breakfast', locale)}><span class="quick-icon">☕</span><h3>{de ? 'Frühstück' : 'Breakfast'}</h3><span class="muted">{de ? 'Zeiten & Allergien' : 'Times & allergies'}</span></a><a class="quick-card" href={hrefFor('contact', locale)}><span class="quick-icon">☎</span><h3>{de ? 'Wir sind für Sie da' : 'We are here for you'}</h3><span class="muted">0911 996910</span></a></div></section></>}

  {route.kind === 'inquiry' && (
    <><section class="page-hero narrow"><p class="eyebrow">{de ? 'Unverbindlich' : 'No obligation'}</p><h1>{de ? 'Anfrage' : 'Inquiry'}</h1><p class="lead muted">{de ? 'Sagen Sie uns, wann und mit wem Sie kommen möchten. Wir melden uns persönlich bei Ihnen.' : 'Tell us when and with whom you would like to stay. We will reply personally.'}</p></section><section class="section tight narrow"><form class="paper-panel form-grid" method="post" action="/api/inquiry"><input type="hidden" name="language" value={locale} /><div class="field honeypot" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div><div class="field"><label for="firstName">{de ? 'Vorname' : 'First name'} *</label><input id="firstName" name="firstName" required autocomplete="given-name" /></div><div class="field"><label for="lastName">{de ? 'Nachname' : 'Last name'} *</label><input id="lastName" name="lastName" required autocomplete="family-name" /></div><div class="field"><label for="phone">{de ? 'Telefonnummer' : 'Phone number'}</label><input id="phone" name="phone" type="tel" autocomplete="tel" /></div><div class="field"><label for="email">{de ? 'E-Mail-Adresse' : 'Email address'} *</label><input id="email" name="email" type="email" required autocomplete="email" /></div><div class="field full"><label for="roomCategory">{de ? 'Zimmerkategorie' : 'Room category'} *</label><select id="roomCategory" name="roomCategory" required><option value="">{de ? 'Bitte auswählen' : 'Please select'}</option>{rooms.map((entry) => <option value={entry.id} selected={Astro.url.searchParams.get('room') === entry.id}>{entry.data.name[locale]}</option>)}</select></div><div class="field"><label for="arrival">{de ? 'Anreisedatum' : 'Arrival date'} *</label><input id="arrival" name="arrival" type="date" required /></div><div class="field"><label for="departure">{de ? 'Abreisedatum' : 'Departure date'} *</label><input id="departure" name="departure" type="date" required /></div><div class="field"><label for="adults">{de ? 'Anzahl Erwachsene' : 'Adults'}</label><input id="adults" name="adults" type="number" min="1" max="30" value="1" /></div><div class="field"><label for="children">{de ? 'Anzahl Kinder' : 'Children'}</label><input id="children" name="children" type="number" min="0" max="20" value="0" /></div><div class="field full"><label for="message">{de ? 'Nachricht' : 'Message'}</label><textarea id="message" name="message"></textarea></div><label class="checkbox field full"><input name="consent" type="checkbox" value="yes" required /><span>{de ? 'Ich habe die ' : 'I have read the '}<a href={hrefFor('datenschutz', locale)}>{de ? 'Datenschutzerklärung' : 'privacy policy'}</a>{de ? ' gelesen und stimme der Verarbeitung zur Bearbeitung meiner Anfrage zu.' : ' and consent to processing for my inquiry.'} *</span></label>{import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ? <div class="field full"><div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}></div><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script></div> : <p class="notice warning field full">{de ? 'Das Formular wird in der geschützten Vorschau erst nach Einrichtung des Spam-Schutzes aktiviert.' : 'The form will be enabled on the protected preview after spam protection is configured.'}</p>}<div class="field full"><button class="button" type="submit" disabled={!import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}>{de ? 'Anfrage abschicken' : 'Send inquiry'}</button></div></form></section></>
  )}

  {route.kind === 'thanks' && (
    <section class="page-hero narrow"><p class="eyebrow">{de ? 'Anfrage gesendet' : 'Inquiry sent'}</p><h1>{de ? 'Vielen Dank' : 'Thank you'}</h1><p class="lead muted">{de ? 'Ihre Nachricht ist bei uns angekommen. Wir melden uns so bald wie möglich persönlich bei Ihnen.' : 'Your message has reached us. We will reply personally as soon as possible.'}</p><a class="button" href={hrefFor('home', locale)}>{de ? 'Zur Startseite' : 'Back home'}</a></section>
  )}

  {route.kind === 'legal' && legalPage && (
    <><section class="page-hero narrow"><p class="eyebrow">{de ? 'Rechtliches' : 'Legal'}</p><h1>{legalPage.data.title[locale]}</h1></section><section class="section tight narrow"><div class="paper-panel prose">{legalPage.data.needsOwnerReview && <p class="notice warning"><strong>{de ? 'Geschützte Vorschau:' : 'Protected preview:'}</strong> {de ? 'Dieser Entwurf wird vor der öffentlichen Freigabe fachlich geprüft.' : 'This draft will be professionally reviewed before public release.'}</p>}<p>{legalPage.data.body[locale]}</p></div></section></>
  )}
</BaseLayout>
