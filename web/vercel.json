{
  "functions": {
    "api/inquiry.ts": { "regions": ["fra1"], "maxDuration": 10 },
    "api/auth.ts": { "regions": ["fra1"] },
    "api/callback.ts": { "regions": ["fra1"] }
  },
  "redirects": [
    { "source": "/unsere-zimmer", "destination": "/zimmer", "permanent": true },
    { "source": "/text", "destination": "/wissenswertes", "permanent": true },
    { "source": "/ueber-uns", "destination": "/über-uns", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/gast",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/en/guest",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
